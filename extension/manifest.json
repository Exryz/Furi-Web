{
  "manifest_version": 2,
  "name": "Sousou no Frieren Startpage",
  "version": "1.0.0",
  "description": "Frieren Blue Moon-weed startpage with live Spotify desktop player",
  "browser_specific_settings": {
    "gecko": {
      "id": "frieren-startpage@kisek.local"
    }
  },
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "permissions": [
    "storage",
    "https://api.spotify.com/*",
    "https://accounts.spotify.com/*",
    "https://api.open-meteo.com/*"
  ],
  "web_accessible_resources": [
    "index.html",
    "icon.png",
    "bg.jpg"
  ],
  "icons": {
    "48": "icon.png",
    "96": "icon.png"
  }
}
